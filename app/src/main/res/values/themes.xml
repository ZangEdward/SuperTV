<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material3 - 浅色模式 (默认) -->
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_green_light</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnBackground">@color/black</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">false</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/white</item>

        <!-- Button style -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>

        <!-- 夜间模式强制深色 -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- 启动页主题：使用更具兼容性的父主题解决闪退 -->
    <style name="Theme.App.Launch" parent="Theme.App">
        <item name="android:windowBackground">@drawable/boot_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.App.NoActionBar" parent="Theme.App">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 修复缺失的主题引用 -->
    <style name="Theme.App.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="Theme.App.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <!-- 保持原有的兼容别名 -->
    <style name="Theme.RESuperTV" parent="Theme.App" />
    <style name="Theme.RESuperTV.NoActionBar" parent="Theme.App.NoActionBar" />
</resources>
